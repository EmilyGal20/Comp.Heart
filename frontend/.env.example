# Optional. The dev server (npm run dev) uses same-origin /api via Vite proxy to http://127.0.0.1:7155
# and WebSockets to /ws/live, so you usually do not need a .env for local work.

# Override the API target (e.g. a remote backend for integration testing)
# VITE_API_BASE_URL=http://localhost:7155/api
