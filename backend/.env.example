# Copy to .env and adjust. FastAPI + Pydantic load this automatically.

# COMPHEART_ENVIRONMENT=development
# DATABASE_URL=sqlite:///./compheart.db
# API_PREFIX=/api
# SECRET_KEY=change-me-in-production
# UPLOADS_DIR=uploads

# Frontend default (Vite dev) uses the same machine; optional override of the CORS-allowed UI origin
# ALLOWED_ORIGIN=http://localhost:8069

# If you open the UI on another host/port and call the API directly (not through Vite proxy), add origins:
# CORS_EXTRA_ORIGINS=http://192.168.1.10:8069,http://mylaptop.local:8069

# Optional: real OpenAI for AI search, task suggestions, and meeting copy (otherwise mock / heuristic fallbacks run)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Email integrations (see backend integration_service for mock/smtp)
